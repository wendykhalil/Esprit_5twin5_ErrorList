APP_KEY=
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solarshare
DB_USERNAME=root
DB_PASSWORD=

# Ollama. Windows PHP uses 127.0.0.1. Compose sets both URLs to http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=220
OLLAMA_ENABLED=false
SOLARSHARE_DEFAULT_CITY=Tunis

# Docker stack. Leave secrets empty. Do not commit generated values.
APP_NAME=SolarShare
APP_ENV=local
APP_DEBUG=true
RUN_MIGRATIONS=false

BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
FILESYSTEM_DISK=local

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
